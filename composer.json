{
    "name": "confrituur/portknock",
    "description": "Knock to whitelist an IP in a OPNsense firewall",
    "license": "MIT",
    "authors": [
        {
            "name": "conFrituur"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "mlocati/ip-lib": "^1.22",
        "monolog/monolog": "^3.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.22",
        "friendsofphp/php-cs-fixer": "^3.0",
        "php-parallel-lint/php-parallel-lint": "^1.1",
        "phpstan/phpstan": "^1.4",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpunit/phpunit": "^13",
        "psy/psysh": "^0.12.22",
        "roave/security-advisories": "dev-latest"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Portknock\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Portknock\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
